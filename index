<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tragaperras 2 Imágenes</title>
  <style>
    :root{--slot-size:120px}
    body {
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
      background: #f0f0f0;
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
    }

    #slot-container {
      display: flex;
      gap: 16px;
      margin-bottom: 18px;
    }

    .slot {
      width: var(--slot-size);
      height: var(--slot-size);
      background: white;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 10px rgba(0,0,0,0.12);
    }

    .slot img {
      width: calc(var(--slot-size) - 20px);
      height: calc(var(--slot-size) - 20px);
      object-fit: contain;
    }

    button {
      padding: 14px 28px;
      font-size: 18px;
      border: none;
      border-radius: 10px;
      background: #007bff;
      color: white;
      cursor: pointer;
      touch-action: manipulation;
    }

    button:active { transform: translateY(1px); }
    button[disabled]{ opacity:0.6; cursor:not-allowed }

    #mensaje {
      margin-top: 16px;
      font-size: 18px;
      font-weight: 600;
      text-align: center;
      padding: 8px 24px;
      max-width: 86%;
      box-sizing: border-box;
    }

    /* segunda línea estilo */
    #mensaje div{ margin-top:6px }
    #mensaje .line1{ font-size:20px }
    @media (min-width:420px){ :root{--slot-size:140px} }
  </style>
</head>
<body>
  <div id="slot-container">
    <div class="slot"><img id="img1" src="interrogacion.png" alt="?" /></div>
    <div class="slot"><img id="img2" src="interrogacion.png" alt="?" /></div>
  </div>

  <button id="tirar">Tirar</button>

  <div id="mensaje" aria-live="polite"></div>

  <script>
    (function(){
      const imagenes = ["carapaco.png", "caradamian.png"]; // las dos imágenes posibles

      const img1 = document.getElementById("img1");
      const img2 = document.getElementById("img2");
      const mensaje = document.getElementById("mensaje");
      const btn = document.getElementById("tirar");

      let spinning = false;

      // seguridad: si por alguna razón el botón no existe, escribir error en consola
      if (!btn) { console.error('Botón "tirar" no encontrado'); return; }

      btn.addEventListener("click", () => {
        if (spinning) return; // evitar múltiples clics
        spinning = true;
        btn.disabled = true;
        mensaje.textContent = "";

        // pequeña animación de "rodar" (simulación)
        let pasos = 18;
        const intervalo = setInterval(() => {
          img1.src = imagenes[Math.floor(Math.random()*imagenes.length)];
          img2.src = imagenes[Math.floor(Math.random()*imagenes.length)];
          pasos--;
          if (pasos === 0) {
            clearInterval(intervalo);
            evaluar();
            spinning = false;
            btn.disabled = false;
          }
        }, 70);
      });

      function evaluar() {
        const a = img1.src.includes("carapaco.png") ? "carapaco" : "caradamian";
        const b = img2.src.includes("carapaco.png") ? "carapaco" : "caradamian";

        // estilos para mantener alejado de los márgenes
        mensaje.style.textAlign = "center";
        mensaje.style.padding = "12px 30px";
        mensaje.style.maxWidth = "86%";
        mensaje.style.margin = "14px auto";

        if (a === "carapaco" && b === "carapaco") {
          mensaje.innerHTML = "<div class='line1' style='text-transform:uppercase'>HAS GANADO</div><div>Tu segundo regalo se encuentra en el cajón de tu amigo invisible.</div>";
          mensaje.style.color = "#1b7a1b";
        } else if (a === "caradamian" && b === "caradamian") {
          mensaje.innerHTML = "<div class='line1' style='text-transform:uppercase'>HAS PERDIDO</div><div>Para seguir jugando debes bailar con algún compañero.</div>";
          mensaje.style.color = "#b21f1f";
        } else {
          mensaje.innerHTML = "<div class='line1'>Vuelve a intentarlo</div>";
          mensaje.style.color = "#b26b1f";
        }
      }

      // accesibilidad: permitir 'Enter' en botón cuando focussed
      btn.addEventListener('keyup', (e)=>{ if(e.key==='Enter') btn.click(); });

    })();
  </script>
</body>
</html>
